@@ -195,6 +195,16 @@ ifelse(SCREEN_SIZE,`Small',
 `define(`FONT_SIZE',BASIC_FONT_SIZE)')
 
 define(`FONT_SIZE_X_2',eval(FONT_SIZE*2))
+
+# TNLFont(weight-slant,pixels): BASIC_FONT as an XLFD with a fixed pixel
+# size. Patterns like BASIC_FONT*bold-r*12* also match the 12 point fonts
+# of the 100dpi directory (17 pixels), which made everything too big.
+define(`TNLFont',`-'BASIC_FONT`-$1-normal--$2-*-*-*-*-*-iso8859-1')
+
+# The title button pixmaps are 18 pixels high; fvwm 2.0 made the title bar
+# FONT_SIZE+6 pixels high for the default font, newer versions make it
+# taller when the locale uses a font set.
+ifdef(`TITLE_HEIGHT',`',`define(`TITLE_HEIGHT',eval(FONT_SIZE+6))')
 ifdef(`USE_CLOSE_FOR_DECORATIONS',`define(`DECORATIONS_CLOSE',`Close')',dnl
 `define(`DECORATIONS_CLOSE',`Delete')')
 
@@ -307,9 +317,9 @@ changecom(#)
 # Fonts - one for window titles, another for icons, and another for the menus
 #
 
-WindowFont	BASIC_FONT*bold-r*FONT_SIZE*
-IconFont	ICON_FONT
-MenuStyle	MENUFORE_COLOR MENUBACK_COLOR MENUSHADE_COLOR BASIC_FONT*medium-r*FONT_SIZE* mwm
+Style "*" Font TNLFont(`bold-r',FONT_SIZE)
+Style "*" IconFont ICON_FONT
+MenuStyle * mwm, Foreground MENUFORE_COLOR, Background MENUBACK_COLOR, Greyed MENUSHADE_COLOR, Font "TNLFont(`medium-r',FONT_SIZE)", AnimationOff
 
 ###########################################################################
 #
