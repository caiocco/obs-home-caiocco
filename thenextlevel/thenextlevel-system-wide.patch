 # Get the user options.  This is the only file the casual user needs
 # to worry about.
-include(`.fvwm2rc.defines')
+# System-wide install: each .fvwm2rc.* file is read from $HOME when the
+# user has a copy there, otherwise from TNL_DIR (passed by FvwmM4 with -D,
+# see the thenextlevel fvwm2rc bootstrap).
+ifdef(`TNL_DIR',`',`define(`TNL_DIR',`/etc/X11/TheNextLevel')')
+ifdef(`TNL_PIXMAPS',`',`define(`TNL_PIXMAPS',`/usr/share/thenextlevel/pixmaps')')
+define(`readFile',`syscmd(`test -f' HOME/$1)ifelse(sysval,0,`include(HOME/$1)',`include(TNL_DIR/$1)')')
+
+# Defined early so that .fvwm2rc.defines can use it
+define(`IfProgramExists',`syscmd(type $1 >/dev/null 2>&1)ifelse(sysval,0,`$2',`#$1 not found')')
+
+readFile(`.fvwm2rc.defines')
 
