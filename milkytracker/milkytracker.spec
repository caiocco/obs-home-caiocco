Name:           milkytracker
Version:        1.06
Release:        0
Summary:        Music tracker inspired by Fasttracker II
License:        GPL-3.0-or-later AND BSD-3-Clause
Group:          Productivity/Multimedia/Sound/Editors and Convertors
URL:            https://milkytracker.org/
Source0:        https://github.com/milkytracker/MilkyTracker/archive/refs/tags/v%{version}.tar.gz#/MilkyTracker-%{version}.tar.gz
BuildRequires:  cmake >= 3.10
BuildRequires:  desktop-file-utils
BuildRequires:  fdupes
BuildRequires:  gcc-c++
BuildRequires:  hicolor-icon-theme
BuildRequires:  libjack-devel
BuildRequires:  pkgconfig
BuildRequires:  pkgconfig(alsa)
BuildRequires:  pkgconfig(liblhasa)
BuildRequires:  pkgconfig(rtmidi)
BuildRequires:  pkgconfig(sdl2)
BuildRequires:  pkgconfig(zlib)
BuildRequires:  pkgconfig(zziplib)

%description
MilkyTracker is a multi-platform music application for creating .MOD
and .XM module files.  It attempts to recreate the module replay and
user experience of the popular DOS program Fasttracker II, with special
playback modes available for improved Amiga ProTracker 2/3
compatibility.

This build supports ALSA, JACK and SDL audio output, MIDI input through
RtMidi, and loading modules packed in ZIP, LHA, LZX, GZIP and PP20
archives.

%prep
%setup -q -n MilkyTracker-%{version}
# upstream forgot to bump the patch level for 1.05.01
sed -i 's/^set(VER_ZZ 00)/set(VER_ZZ 01)/' CMakeLists.txt
# Encoding is deprecated in desktop entries
sed -i '/^Encoding=/d' resources/milkytracker.desktop
chmod -x COPYING AUTHORS

%build
%cmake
%cmake_build

%install
%cmake_install
install -Dpm 0644 resources/milkytracker.desktop \
    %{buildroot}%{_datadir}/applications/milkytracker.desktop
# generated by CMake (version and release date filled in)
install -Dpm 0644 %{__builddir}/resources/org.milkytracker.MilkyTracker.metainfo.xml \
    %{buildroot}%{_datadir}/metainfo/org.milkytracker.MilkyTracker.metainfo.xml
install -Dpm 0644 resources/pictures/carton.png \
    %{buildroot}%{_datadir}/icons/hicolor/128x128/apps/milkytracker.png
# the licence goes in %%license
rm %{buildroot}%{_docdir}/%{name}/Copying.txt
%fdupes %{buildroot}%{_datadir}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/milkytracker.desktop

%files
%license COPYING
%doc README.md ChangeLog.md
%{_bindir}/milkycli
%{_bindir}/milkytracker
%{_docdir}/%{name}/
%{_datadir}/milkytracker/
%{_datadir}/applications/milkytracker.desktop
%{_datadir}/icons/hicolor/128x128/apps/milkytracker.png
%{_datadir}/metainfo/org.milkytracker.MilkyTracker.metainfo.xml

%changelog
