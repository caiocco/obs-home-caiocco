@@ -1062,6 +1062,20 @@
     return hex.toUpper();
 }
 
+double DkUtils::platformFontScale()
+{
+    // QApplication::font() is not affected by style sheets, so this is the platform font
+    const double pt = QApplication::font().pointSizeF();
+    if (pt <= 0)
+        return 1.0;
+    return pt / 11.0; // nomacs designs its sizes around an 11pt UI font
+}
+
+int DkUtils::scaledFontSize(int designSize)
+{
+    return qMax(1, qRound(designSize * platformFontScale()));
+}
+
 QString DkUtils::colorToString(const QColor &col)
 {
