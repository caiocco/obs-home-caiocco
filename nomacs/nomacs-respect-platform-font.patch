     cssString = replaceMacros(cssString, colors);
     cssString = replaceColors(cssString, colors); // must follow macro replacement
 
+    // openSUSE home:caiocco: stylesheet.css forces an 11pt UI font (and sizes relative to it),
+    // which overrides the system font size. Scale all font sizes to the platform font.
+    {
+        const double scale = DkUtils::platformFontScale();
+        if (scale != 1.0) {
+            static const QRegularExpression re(QStringLiteral(R"((font-size\s*:\s*)(\d+(?:\.\d+)?)\s*(pt|px))"));
+            QString out;
+            qsizetype last = 0;
+            auto it = re.globalMatch(cssString);
+            while (it.hasNext()) {
+                const auto m = it.next();
+                const double size = qMax(1.0, std::round(m.captured(2).toDouble() * scale));
+                out += QStringView(cssString).mid(last, m.capturedStart() - last);
+                out += m.captured(1) + QString::number(size) + m.captured(3);
+                last = m.capturedEnd();
+            }
+            out += QStringView(cssString).mid(last);
+            cssString = out;
+        }
+    }
+
     const DkSettings::Display &d = DkSettingsManager::param().display();
 
