[Desktop Entry]
Type=Application
Name=XImaging
GenericName=Image Viewer
Comment=Browse and view raster images with a Motif image viewer
Exec=ximaging -browse %f
Icon=ximaging
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Viewer;Motif;
MimeType=image/jpeg;image/png;image/tiff;image/bmp;image/x-bmp;image/x-tga;image/x-sgi;image/x-sun-raster;image/x-pcx;image/x-xpixmap;image/x-xbitmap;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;
