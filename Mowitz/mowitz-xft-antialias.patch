+#ifdef MW_XFT
+/*
+ * Antialiased glyphs: draw the same Type 1 font files that t1lib uses
+ * through Xft/FreeType. Glyphs are still placed one by one at the AFM
+ * positions, so layout and printing do not change. Set MW_NO_XFT in
+ * the environment to get the old t1lib bitmaps.
+ */
+static int mw_xft_state = -1;		/* -1 unknown, 0 off, 1 on */
+
+static struct mw_xft_cache {
+	int id;
+	int pixels;
+	XftFont *font;
+	struct mw_xft_cache *next;
+} *mw_xft_fonts = NULL;
+
+static int mw_xft_on(void)
+{
+	if (mw_xft_state == -1)
+		mw_xft_state = getenv("MW_NO_XFT") == NULL &&
+			DefaultVisual(t1_dpy, t1_scrn)->class == TrueColor;
+	return mw_xft_state;
+}
+
+static XftFont *mw_xft_font(int id, double size)
+{
+	struct mw_xft_cache *c;
+	int pixels = (int)(size * 64 + 0.5);	/* 1/64 pixel steps */
+	char *path;
+	FcPattern *pat;
+	XftFont *f = NULL;
+
+	for (c = mw_xft_fonts; c; c = c->next)
+		if (c->id == id && c->pixels == pixels) return c->font;
+
+	path = T1_GetFontFilePath(id);
+	if (path) {
+		pat = FcPatternCreate();
+		FcPatternAddString(pat, FC_FILE, (FcChar8 *)path);
+		FcPatternAddInteger(pat, FC_INDEX, 0);
+		FcPatternAddDouble(pat, FC_PIXEL_SIZE, pixels / 64.0);
+		FcConfigSubstitute(NULL, pat, FcMatchPattern);
+		XftDefaultSubstitute(t1_dpy, t1_scrn, pat);
+		/* XftFontOpenPattern loads exactly this file */
+		f = XftFontOpenPattern(t1_dpy, pat);
+		if (f == NULL) FcPatternDestroy(pat);
+	}
+	c = MwMalloc(sizeof *c);
+	c->id = id;
+	c->pixels = pixels;
+	c->font = f;		/* NULL: fall back to t1lib */
+	c->next = mw_xft_fonts;
+	mw_xft_fonts = c;
+	return f;
+}
+
+/* the GC's foreground as an XftColor (TrueColor only) */
+static void mw_xft_color(GC gc, XftColor *xc)
+{
+	static unsigned long last_pixel = ~0UL;
+	static XRenderColor last;
+	XGCValues v;
+	Visual *vis = DefaultVisual(t1_dpy, t1_scrn);
+
+	XGetGCValues(t1_dpy, gc, GCForeground, &v);
+	if (v.foreground != last_pixel) {
+		unsigned long m[3];
+		unsigned short *out[3];
+		int i;
+
+		m[0] = vis->red_mask;
+		m[1] = vis->green_mask;
+		m[2] = vis->blue_mask;
+		out[0] = &last.red;
+		out[1] = &last.green;
+		out[2] = &last.blue;
+		for (i = 0; i < 3; i++) {
+			unsigned long mask = m[i], val;
+			int shift = 0, bits = 0;
+			while (mask && !(mask & 1)) mask >>= 1, shift++;
+			while (mask & 1) mask >>= 1, bits++;
+			val = (v.foreground >> shift) & ((1UL << bits) - 1);
+			*out[i] = bits ? val * 0xffff / ((1UL << bits) - 1) : 0;
+		}
+		last.alpha = 0xffff;
+		last_pixel = v.foreground;
+	}
+	xc->pixel = v.foreground;
+	xc->color = last;
+}
+
+static int mw_xft_char(Drawable d, GC gc, int x, int y, int id,
+		double size, unsigned char ch)
+{
+	XftFont *f;
+	XftDraw *xd;
+	XftColor xc;
+
+	if (!mw_xft_on() || (f = mw_xft_font(id, size)) == NULL)
+		return 0;
+	/* a fresh XftDraw each time: Mowitz draws into short-lived
+	   pixmaps, and a cached Render picture could outlive them */
+	xd = XftDrawCreate(t1_dpy, d, DefaultVisual(t1_dpy, t1_scrn),
+			DefaultColormap(t1_dpy, t1_scrn));
+	if (xd == NULL) return 0;
+	mw_xft_color(gc, &xc);
+	XftDrawString8(xd, &xc, f, x, y, &ch, 1);
+	XftDrawDestroy(xd);
+	return 1;
+}
+#endif	/* MW_XFT */
