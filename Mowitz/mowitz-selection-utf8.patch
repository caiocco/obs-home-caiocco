+/* ARGSUSED */
+static void
+RequestUtf8Selection(Widget aw, XtPointer client, Atom * selection,
+  Atom * type, XtPointer value, unsigned long *length, int *format)
+{
+  if (value == NULL || *length == 0 || *type != MwUtf8Atom(XtDisplay(aw))) {
+    /* the owner has no UTF8_STRING; ask for plain STRING */
+    if (value) XtFree((char *) value);
+    XtGetSelectionValue(aw, *selection, XA_STRING,
+      RequestSelection, client,
+      XtLastTimestampProcessed(XtDisplay(aw)));
+    return;
+  }
+  RequestSelection(aw, client, selection, type, value, length, format);
 }
 
