 /* collect directory contents */
 
+/*
+ * The dialog shows and edits names in ISO 8859-1, like the rest of
+ * Mowitz, but file names on disk are in the locale's encoding (UTF-8
+ * nowadays). Convert at the boundary. Names that do not fit in
+ * Latin-1, or are not valid UTF-8, are passed through unchanged so
+ * they still round trip.
+ */
+static int utf8_locale(void)
+{
+	const char *cs = nl_langinfo(CODESET);
+	return cs && (!strcmp(cs, "UTF-8") || !strcmp(cs, "utf8"));
+}
+
+/* Decode UTF-8 to Latin-1; returns 0 if src is not all Latin-1 UTF-8 */
+static int utf8_to_latin1(char *dst, const char *src, size_t n)
+{
+	const unsigned char *p = (const unsigned char *)src;
+	size_t i = 0;
+
+	while (*p) {
+		unsigned c = *p;
+		if (c < 0x80) p++;
+		else if ((c == 0xc2 || c == 0xc3) && (p[1] & 0xc0) == 0x80) {
+			c = ((c & 0x1f) << 6) | (p[1] & 0x3f);
+			p += 2;
+		} else return 0;
+		if (i + 1 >= n) return 0;
+		dst[i++] = (char)c;
+	}
+	dst[i] = '\0';
+	return 1;
+}
+
+static int valid_utf8(const char *src)
+{
+	const unsigned char *p = (const unsigned char *)src;
+	while (*p) {
+		int k;
+		if (*p < 0x80) k = 0;
+		else if ((*p & 0xe0) == 0xc0 && *p >= 0xc2) k = 1;
+		else if ((*p & 0xf0) == 0xe0) k = 2;
+		else if ((*p & 0xf8) == 0xf0 && *p <= 0xf4) k = 3;
+		else return 0;
+		p++;
+		while (k--) {
+			if ((*p & 0xc0) != 0x80) return 0;
+			p++;
+		}
+	}
+	return 1;
+}
+
+/* file system name -> what the dialog shows */
+static char *fs2disp(char *dst, const char *src, size_t n)
+{
+	if (!utf8_locale() || !utf8_to_latin1(dst, src, n)) {
+		strncpy(dst, src, n - 1);
+		dst[n - 1] = '\0';
+	}
+	return dst;
+}
+
+/* what the dialog shows or the user typed -> file system name */
+static char *disp2fs(char *dst, const char *src, size_t n)
+{
+	const unsigned char *p = (const unsigned char *)src;
+	size_t i = 0;
+
+	if (!utf8_locale() || valid_utf8(src)) {
+		strncpy(dst, src, n - 1);
+		dst[n - 1] = '\0';
+		return dst;
+	}
+	for (; *p && i + 2 < n; p++) {
+		if (*p < 0x80) dst[i++] = *p;
+		else {
+			dst[i++] = 0xc0 | (*p >> 6);
+			dst[i++] = 0x80 | (*p & 0x3f);
+		}
+	}
+	dst[i] = '\0';
+	return dst;
+}
