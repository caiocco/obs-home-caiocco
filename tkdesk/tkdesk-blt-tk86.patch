-#ifndef HAVE_STRDUP
+#ifndef WIN32
+/*
+ * Blt_Strdup, Blt_Calloc --
+ *
+ *	strdup/calloc replacements that allocate from Tcl's heap, so the
+ *	result can be released with Tcl_Free (see bltInt.h).
+ */
+char *
+Blt_Strdup(const char *string)
+{
+    size_t n = strlen(string) + 1;
+    char *newPtr = Tcl_Alloc(n);
+
+    memcpy(newPtr, string, n);
+    return newPtr;
+}
+
+void *
+Blt_Calloc(size_t nElems, size_t size)
+{
+    size_t n = nElems * size;
+    char *ptr = Tcl_Alloc(n);
+
+    memset(ptr, 0, n);
+    return ptr;
+}
+#endif /* !WIN32 */
