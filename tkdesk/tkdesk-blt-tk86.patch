+#ifndef WIN32
+/*
+ * Tcl 8.6 has its own allocator: memory returned by Tcl_SplitList,
+ * Tcl_Merge and friends must be released with Tcl_Free, never with the
+ * C library's free().  Do what BLT already does on Windows and route
+ * all of BLT's own allocations through Tcl as well, so that every
+ * free() here matches.
+ */
+#define malloc(s)		Tcl_Alloc(s)
+#define realloc(p, s)		Tcl_Realloc((char *)(p), (s))
+#define free(p)			Tcl_Free((char *)(p))
+#define strdup(s)		Blt_Strdup(s)
+#define calloc(n, s)		Blt_Calloc((n), (s))
+EXTERN char *Blt_Strdup _ANSI_ARGS_((const char *string));
+EXTERN void *Blt_Calloc _ANSI_ARGS_((size_t nElems, size_t size));
+#endif /* !WIN32 */
