+    def _snapshot_include_entries(self):
+        """Read the include list of the current profile from the config
+        file archived in the selected snapshot. Return None if it can't be
+        read."""
+        prefix = 'profile{}.snapshots.include.'.format(
+            self.config.currentProfile())
+        values = {}
+        types = {}
+
+        try:
+            with open(self.parent.sid.path('config'), encoding='utf-8') as fh:
+                for line in fh:
+                    key, sep, value = line.rstrip('\n').partition('=')
+                    if not sep or not key.startswith(prefix):
+                        continue
+                    idx, _sep, field = key[len(prefix):].partition('.')
+                    if field == 'value':
+                        values[idx] = value
+                    elif field == 'type':
+                        types[idx] = value
+
+        except OSError:
+            return None
+
+        if not values:
+            return None
+
+        return [
+            (values[idx], int(types.get(idx, 0)))
+            for idx in sorted(values, key=lambda i: int(i) if i.isdigit() else 0)
+        ]
