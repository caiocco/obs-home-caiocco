+
+static void cb_quit_save_(Widget widget, XtPointer client_data, XtPointer call_data)
+{
+    PaintContext* ctx = &g_paint_ctx;
+    quit_dialog_close_();
+
+    // place a pending text box or floating selection into the image
+    paint_set_tool(ctx, ctx->tool);
+    ui_disable_editing_text();
+    ui_refresh_drawing(0);
+
+    if (paint_file_path(ctx))
+    {
+        if (paint_save_file(ctx))
+        {
+            XtAppSetExitFlag(g_app);
+        }
+        else
+        {
+            show_save_error_();
+        }
+    }
+    else
+    {
+        quit_after_save = 1;
+        show_save_dialog_();
+    }
+}
+
+static void cb_quit_discard_(Widget widget, XtPointer client_data, XtPointer call_data)
+{
+    quit_dialog_close_();
+    XtAppSetExitFlag(g_app);
+}
+
+static void cb_quit_cancel_(Widget widget, XtPointer client_data, XtPointer call_data)
+{
+    quit_dialog_close_();
+}
+
+static void cb_quit_destroy_(Widget widget, XtPointer client_data, XtPointer call_data)
+{
+    quit_dialog = NULL;
+}
+
+// Called by File > Exit and by the window manager's close button.
+void ui_request_quit(void)
+{
+    PaintContext* ctx = &g_paint_ctx;
+
+    if (!paint_is_modified(ctx))
+    {
+        XtAppSetExitFlag(g_app);
+        return;
+    }
+
+    if (quit_dialog)
+    {
+        XtManageChild(quit_dialog);
+        return;
+    }
+
+    char name[OS_PATH_MAX];
+    const char* path = paint_file_path(ctx);
+    if (path)
+    {
+        char temp_path[OS_PATH_MAX];
+        strncpy(temp_path, path, OS_PATH_MAX);
+        temp_path[OS_PATH_MAX - 1] = '\0';
+        snprintf(name, OS_PATH_MAX, "%s", basename(temp_path));
+    }
+    else
+    {
+        snprintf(name, OS_PATH_MAX, "Untitled");
+    }
+
+    char text[OS_PATH_MAX + 64];
+    snprintf(text, sizeof(text), "Do you want to save changes to \"%s\"?", name);
+
+    int n = 0;
+    Arg args[UI_ARGS_MAX];
+    XmString message = XmStringCreateLocalized(text);
+    XmString title = XmStringCreateLocalized("Classic Colors");
+    XmString save = XmStringCreateLocalized("Save");
+    XmString cancel = XmStringCreateLocalized("Cancel");
+    XtSetArg(args[n], XmNmessageString, message); ++n;
+    XtSetArg(args[n], XmNdialogTitle, title); ++n;
+    XtSetArg(args[n], XmNokLabelString, save); ++n;
+    XtSetArg(args[n], XmNcancelLabelString, cancel); ++n;
+    XtSetArg(args[n], XmNdefaultButtonType, XmDIALOG_OK_BUTTON); ++n;
+    XtSetArg(args[n], XmNdialogStyle, XmDIALOG_FULL_APPLICATION_MODAL); ++n;
+    XtSetArg(args[n], XmNdeleteResponse, XmDESTROY); ++n;
+    quit_dialog = XmCreateWarningDialog(g_main_w, "quit_dialog", args, n);
+
+    // An extra child of a message box is placed after the OK button:
+    // Save | Don't Save | Cancel
+    XmString discard_str = XmStringCreateLocalized("Don't Save");
+    Widget discard = XtVaCreateManagedWidget("dont_save",
+            xmPushButtonWidgetClass, quit_dialog,
+            XmNlabelString, discard_str,
+            NULL);
+    XmStringFree(discard_str);
+
+    XtAddCallback(quit_dialog, XmNokCallback, cb_quit_save_, NULL);
+    XtAddCallback(discard, XmNactivateCallback, cb_quit_discard_, NULL);
+    XtAddCallback(quit_dialog, XmNcancelCallback, cb_quit_cancel_, NULL);
+    XtAddCallback(quit_dialog, XmNdestroyCallback, cb_quit_destroy_, NULL);
+    XtUnmanageChild(XtNameToWidget(quit_dialog, "Help"));
+
+    XtManageChild(quit_dialog);
+
+    XmStringFree(message);
+    XmStringFree(title);
+    XmStringFree(save);
+    XmStringFree(cancel);
+}
