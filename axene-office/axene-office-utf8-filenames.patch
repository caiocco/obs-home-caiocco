+/*--- File name encoding ---*/
+/* The interface is Latin-1 (core iso8859-1 fonts, Latin-1 keyboard
+** input), but under a UTF-8 locale the file names on disk are UTF-8:
+** "Música/" was listed as "MÃºsica/".  The list and the folder menu show
+** a Latin-1 label; the name itself is kept as read from the disk, and
+** typed text is converted back to UTF-8. */
+static int fs_utf8_names = -1;
+
+static boolean fs_utf8()
+{
+ if(fs_utf8_names < 0)
+ {
+  char *loc;
+
+  if(((loc = getenv("LC_ALL")) == NULL) || !*loc)
+   if(((loc = getenv("LC_CTYPE")) == NULL) || !*loc)
+    loc = getenv("LANG");
+  fs_utf8_names = (loc && (strstr(loc, "UTF-8") || strstr(loc, "utf-8") ||
+			   strstr(loc, "UTF8") || strstr(loc, "utf8")))? 1 : 0;
+ }
+ return fs_utf8_names? TRUE : FALSE;
+}
+
+static char *fs_iconv(to, from, s)
+char *to;
+char *from;
+char *s;
+{
+ iconv_t cd;
+ size_t inl, outl;
+ char *in, *out, *o;
+
+ if((cd = iconv_open(to, from)) == (iconv_t)-1) return NULL;
+ inl = strlen(s);
+ outl = 2 * inl + 1;
+ if((out = Xc_malloc("filename", outl)) != NULL)
+ {
+  in = s;
+  o = out;
+  if(iconv(cd, &in, &inl, &o, &outl) == (size_t)-1)
+  {
+   Xc_free(out);
+   out = NULL;
+  }
+  else
+   *o = 0;
+ }
+ iconv_close(cd);
+ return out;
+}
+
+/* Label for a name read from the disk */
+static char *fs_label(name)
+char *name;
+{
+ char *label;
+
+ if(fs_utf8())
+ {
+  if((label = fs_iconv("ISO-8859-1", "UTF-8", name)) != NULL) return label;
+  /* valid UTF-8 outside Latin-1: shown with '?' */
+  if((label = fs_iconv("ISO-8859-1//TRANSLIT", "UTF-8", name)) != NULL)
+   return label;
+  /* not UTF-8 (an old Latin-1 name): shown as is */
+ }
+ return Xc_strdup("filename", name);
+}
+
+/* Name on the disk for text typed in the interface */
+static char *fs_raw(text)
