+   Xc_free(file->label);
+  }
   Xc_destroyItem(this->item_h);
  }
 
@@ -361,6 +482,15 @@ c_FileSelector *this;
   {
    if((file = F(this->text_field).get(this->text_field)) != NULL)
    {
+    char *raw;
+
+    raw = fs_text_to_raw(this, file);
+    Xc_free(file);
+    if((file = raw) == NULL)
+    {
+     Xc_free(path);
+     return NULL;
+    }
     len = strlen(path) + strlen(file) + 1;
     if((new = Xc_realloc("filename", path, len)) == NULL)
     {
@@ -420,6 +550,7 @@ char *path;
     tmp = file;
     file = file->next;
     Xc_free(tmp->name);
+    Xc_free(tmp->label);
     Xc_delete(this->item_h, tmp);
    }
    this->path = file;
@@ -571,6 +702,7 @@ c_FileSelector *this;
   tmp = file;
   file = file->next;
   Xc_free(tmp->name);
+  Xc_free(tmp->label);
   Xc_delete(this->item_h, tmp);
  }
  this->files = NULL;
@@ -646,9 +778,16 @@ c_FileSelector *this;
     }
     file->name[file_len] = 0;
 
+    if((file->label = fs_label(file->name)) == NULL)
+    {
+     Xc_free(file->name);
+     continue;
+    }
+
     if(is_really_interresting(this, file) == FALSE)
     {
      Xc_free(file->name);
+     Xc_free(file->label);
     }
     else
     {
@@ -691,6 +830,12 @@ fs_file_t *folder;
   Xc_delete(this->item_h, file);
   return FALSE;
  }
+ if((file->label = fs_label(file->name)) == NULL)
+ {
+  Xc_free(file->name);
+  Xc_delete(this->item_h, file);
+  return FALSE;
+ }
 
  file->next = this->path;
  this->path = file;
@@ -731,7 +876,7 @@ int reason;
   {
    char *string;
 	  
-   if((string = Xc_strdup("filename", selection[0]->name)) != NULL)
+   if((string = Xc_strdup("filename", selection[0]->label)) != NULL)
    {
     if((selection[0]->type == XcFS_LINK) ||
        (selection[0]->type == XcFS_SPECIAL))
@@ -779,6 +924,7 @@ fs_file_t *file;
    tmp = ptr;
    ptr = ptr->next;
    Xc_free(tmp->name);
+   Xc_free(tmp->label);
    Xc_delete(this->item_h, tmp);
   }
   this->path = ptr;
@@ -826,9 +972,13 @@ c_FileSelector *this;
   if((*ptr == '~') || (ptr[0] == '.' && ptr[1] == '.') || 
      (strchr(ptr, '/') != NULL))
   {
+   char *raw;
+
    XcFS_END_UPDATE_PROC(this);
-   if ((IsDirExist(ptr) || !strcmp(ptr, "~"))
-       && F(this).setPath(this, ptr))
+   if((raw = fs_raw(ptr)) == NULL)
+    ;
+   else if ((IsDirExist(raw) || !strcmp(raw, "~"))
+       && F(this).setPath(this, raw))
    {
     ptr = NULL;
     flag = TRUE;
@@ -838,7 +988,7 @@ c_FileSelector *this;
    {
     char *dir;
 	      
-    if ((dir = GetDirname(ptr, TRUE)) != NULL)
