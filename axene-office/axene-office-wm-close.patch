 };
 
 
+extern void MenuFileClose();
+
+static void cb_wm_close(w, client, call)
+Widget w;
+XtPointer client, call;
+{
+ MenuFileClose(w, (c_Interface *)client);
+}
+
 static void *cons_Interface(MainInterface)
 c_MainInterface *MainInterface;
 {
@@ -75,6 +85,14 @@ c_MainInterface *MainInterface;
  This->MainInterface = MainInterface;
  This->Manager = (c_ManageWidget *)NEW(c_ManageWidget)();
  F(This->MainInterface).create_TopLevel(This->MainInterface, This->Manager);
+ /* close this window (or quit on the last one) when the window
+    manager closes it, instead of destroying it under our feet */
+ XtVaSetValues(This->MainInterface->w_Main, XmNdeleteResponse,
+	       XmDO_NOTHING, NULL);
+ XmAddWMProtocolCallback(This->MainInterface->w_Main,
+			 XmInternAtom(XtDisplay(This->MainInterface->w_Main),
+				      "WM_DELETE_WINDOW", False),
+			 cb_wm_close, (XtPointer)This);
  F(GlobDocIcon).registerPixmapConverters(GlobDocIcon);
  create_interface(This);
   
