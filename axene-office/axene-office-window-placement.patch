index 73cdcf2..b4dab0a 100644
--- a/XAllWrite-2.0.1/Sources/RegisterHelp/RegisterHelp.c
+++ b/XAllWrite-2.0.1/Sources/RegisterHelp/RegisterHelp.c
@@ -74,6 +74,172 @@ extern boolean mozilla_remote_free_lock();
