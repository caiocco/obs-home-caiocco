+/* ************************************************************************ */
+/* **                 LAUNCHER STATE (~/.axeneofficerc)                  ** */
+/* ************************************************************************ */
+/* The bar reopens where it was left, in the same layout (vertical or
+   horizontal), shaped without window manager ("WM Activ" off) or not,
+   and with or without the window manager buttons ("WM Buttons").
+   The position is the frame's top left corner when the window manager
+   handles the bar, the window's own corner otherwise. */
+
+
+static char *state_filename()
+{
+ char *home = getenv("HOME");
+
+ return Xc_strconcat(home ? home : "", "/", STATE_FILE, NULL);
+}
+
+static void read_state(argc, argv)
+int argc;
+char **argv;
+{
+ FILE *f;
+ char *name, line[100];
+ int a, b, i;
+
+ if ((name = state_filename()) == NULL)
+  return;
+ f = fopen(name, "r");
+ Xc_free(name);
+ if (f == NULL)
+  return;
+ while (fgets(line, sizeof(line), f))
+ {
+  if (sscanf(line, "position %d %d", &a, &b) == 2)
+  {
+   state.have_pos = TRUE;
+   state.x = a;
+   state.y = b;
+  }
+  else if (sscanf(line, "vertical %d", &a) == 1)
+   state.vertical = a ? TRUE : FALSE;
+  else if (sscanf(line, "override %d", &a) == 1)
+   state.override = a ? TRUE : FALSE;
+  else if (sscanf(line, "transient %d", &a) == 1)
+   state.transient = a ? TRUE : FALSE;
+ }
+ fclose(f);
+ state.loaded = TRUE;
+
+ /* an explicit -geometry wins over the saved position */
+ for (i = 1; i < argc; i++)
+  if (!strcmp(argv[i], "-geom") || !strcmp(argv[i], "-geometry"))
+   state.have_pos = FALSE;
+
+ /* "-1" in a geometry means from the right edge: negative positions
+    are off the monitors anyway, launcher_restore resets them */
+ if (state.have_pos && state.x >= 0 && state.y >= 0)
+ {
+  sprintf(state_geometry, "+%d+%d", state.x, state.y);
+  launcher_geometry = state_geometry;
+ }
+}
+
+static long frame_extent(display, window, index)
+Display *display;
+Window window;
+int index;
+{
+ Atom type;
+ int format;
+ unsigned long nitems, after;
+ unsigned char *data = NULL;
+ long value = 0;
+
+ if (XGetWindowProperty(display, window,
+			XInternAtom(display, "_NET_FRAME_EXTENTS", False),
+			0, 4, False, XA_CARDINAL, &type, &format, &nitems,
+			&after, &data) == Success && data &&
+     type == XA_CARDINAL && format == 32 && nitems == 4)
+  value = ((long *)data)[index];
+ if (data)
+  XFree(data);
+ return value;
+}
 
+static void write_state(This)
+c_Interface *This;
+{
+ Widget shell = This->MainInterface->w_Main;
+ Display *display = XtDisplay(shell);
+ Window window = XtWindow(shell), child;
+ XWindowAttributes wa;
+ char *name, *tmp;
+ FILE *f;
+ int x, y;
+
+ if (window && XGetWindowAttributes(display, window, &wa) &&
+     wa.map_state == IsViewable)
+ {
+  XTranslateCoordinates(display, window, wa.root, 0, 0, &x, &y, &child);
+  if (!This->override)
+  {
+   x -= (int)frame_extent(display, window, 0);
+   y -= (int)frame_extent(display, window, 2);
+  }
+  state.have_pos = TRUE;
+  state.x = x;
+  state.y = y;
+ }
+ state.vertical = This->flip;
+ state.override = This->override;
+ state.transient = This->transient;
 
+ if ((name = state_filename()) == NULL)
+  return;
+ tmp = Xc_strconcat(name, "~new", NULL);
+ if (tmp && (f = fopen(tmp, "w")) != NULL)
+ {
+  fprintf(f, "# Axene Office launcher state, rewritten on every change\n");
+  if (state.have_pos)
+   fprintf(f, "position %d %d\n", state.x, state.y);
+  fprintf(f, "vertical %d\noverride %d\ntransient %d\n",
+	  state.vertical ? 1 : 0, state.override ? 1 : 0,
+	  state.transient ? 1 : 0);
+  if (fclose(f) == 0)
+   rename(tmp, name);
+ }
+ if (tmp)
+  Xc_free(tmp);
+ Xc_free(name);
+}
+
+static void save_timeout(This)
+c_Interface *This;
+{
+ SaveTimeOutid = (XtIntervalId)0;
+ write_state(This);
+}
+
+/* save once things settle (moves come as bursts of ConfigureNotify) */
+static void schedule_save(This)
+c_Interface *This;
+{
+ if (!state_restored)
+  return;
+ if (SaveTimeOutid != (XtIntervalId)0)
+  XtRemoveTimeOut(SaveTimeOutid);
+ SaveTimeOutid = XtAppAddTimeOut(XtWidgetToApplicationContext
+				 (This->MainInterface->w_Main), 800L,
+				 (XtTimerCallbackProc)save_timeout, This);
+}
+
+/* Is the w x h rectangle at x, y entirely on one monitor? */
+static boolean on_a_monitor(display, x, y, w, h)
+Display *display;
+int x, y, w, h;
+{
+ XineramaScreenInfo *mon;
+ int i, n;
+ boolean ok = FALSE;
+
+ if (XineramaIsActive(display) &&
+     (mon = XineramaQueryScreens(display, &n)) != NULL)
+ {
+  for (i = 0; i < n && !ok; i++)
+   ok = x >= mon[i].x_org && y >= mon[i].y_org &&
+	x + w <= mon[i].x_org + mon[i].width &&
+	y + h <= mon[i].y_org + mon[i].height;
+  XFree(mon);
+  return ok;
+ }
+ return x >= 0 && y >= 0 &&
+	x + w <= DisplayWidth(display, DefaultScreen(display)) &&
+	y + h <= DisplayHeight(display, DefaultScreen(display));
+}
+
+/* centre of the monitor under the pointer */
+static void safe_position(display, w, h, x, y)
+Display *display;
+int w, h, *x, *y;
+{
+ XineramaScreenInfo *mon;
+ Window root, child;
+ int px = 0, py = 0, wx, wy, i, n;
+ unsigned int mask;
+ int mx = 0, my = 0;
+ int mw = DisplayWidth(display, DefaultScreen(display));
+ int mh = DisplayHeight(display, DefaultScreen(display));
+
+ XQueryPointer(display, DefaultRootWindow(display), &root, &child,
+	       &px, &py, &wx, &wy, &mask);
+ if (XineramaIsActive(display) &&
+     (mon = XineramaQueryScreens(display, &n)) != NULL)
+ {
+  for (i = 0; i < n; i++)
+   if (px >= mon[i].x_org && px < mon[i].x_org + mon[i].width &&
+       py >= mon[i].y_org && py < mon[i].y_org + mon[i].height)
+    break;
+  if (i == n)
+   i = 0;
+  mx = mon[i].x_org;
+  my = mon[i].y_org;
+  mw = mon[i].width;
+  mh = mon[i].height;
+  XFree(mon);
+ }
+ *x = mx + (mw - w) / 2;
+ *y = my + (mh - h) / 2;
+}
+
+/* ----------------------------------------------------------------- **
+** launcher_restore - set the saved modes and check the saved        **
+** position before the bar is mapped (called by the Interface)       **
+** ----------------------------------------------------------------- */
+void launcher_restore(This)
+c_Interface *This;
+{
+ Widget shell = This->MainInterface->w_Main;
+ Display *display = XtDisplay(shell);
+ Dimension width, height;
+ int i, x, y;
+
+ XtVaGetValues(WIDGET(This->Icon[0]), XmNwidth, &iW, XmNheight, &iH, NULL);
+ XtVaGetValues(WIDGET(This->rcMain), XmNmarginWidth, &mW,
+	       XmNmarginHeight, &mH, XmNspacing, &S, NULL);
+
+ if (state.vertical)
+ {
+  This->flip = TRUE;
+  width = iW + 2*mW;
+  height = (This->nbIcon * iH) + ((This->nbIcon -1) * S) + 2*mH;
+  F(This->popup).ToggleManage(This->popup,
+			      POPUP_FLIP_VERTICAL, POPUP_FLIP_HORIZONTAL);
+  XtVaSetValues(shell, XmNminWidth, width,
+		XmNmaxWidth, width, XmNwidth, width,
+		XmNmaxHeight, height, XmNminHeight, height,
+		XmNheight, height, NULL);
+  XtVaSetValues(WIDGET(This->rcMain), XmNorientation, XmVERTICAL, NULL);
+ }
+ else
+ {
+  height = iH + 2*mH;
+  width = (This->nbIcon * iW) + ((This->nbIcon -1) * S) + 2*mW;
+ }
+
+ if (!state.transient)
+ {
+  This->transient = FALSE;
+  XtVaSetValues(shell, XmNtransient, False, NULL);
+  F(This->popup).ToggleButton(This->popup, POPUP_TRANSIENT, True);
+ }
+
+ if (state.override)
+ {
+  This->override = TRUE;
+  XtVaSetValues(shell, XmNoverrideRedirect, True, NULL);
+  for(i = 0; i < This->nbIcon; i++)
+   XtVaSetValues(WIDGET(This->Icon[i]), XmNhighlightThickness, 0, NULL);
+  XtVaSetValues(WIDGET(This->rcMain), XmNmarginWidth, mW+1,
+		XmNmarginHeight, mH+1, XmNspacing, S+2, NULL);
+  F(This->popup).ButtonFlag(This->popup, POPUP_TRANSIENT, False);
+  F(This->popup).ToggleButton(This->popup, POPUP_OVERRIDE, False);
+ }
+
+ /* a position off the monitors (one unplugged, resolution changed...)
+    is dropped: the bar goes to the middle of the pointer's monitor */
+ if (state.have_pos && !on_a_monitor(display, state.x, state.y,
+				     (int)width, (int)height))
+ {
+  Xc_WARNING(("saved launcher position %d,%d is off screen, reset",
+	      state.x, state.y));
+  state.have_pos = FALSE;
+  safe_position(display, (int)width, (int)height, &x, &y);
+  sprintf(state_geometry, "+%d+%d", MAX(x, 0), MAX(y, 0));
+  XtVaSetValues(shell, XmNgeometry, state_geometry,
+		XmNx, (Position)x, XmNy, (Position)y, NULL);
+ }
+ else if (!state.have_pos && state.override)
+ {
+  /* no window manager will place it */
+  safe_position(display, (int)width, (int)height, &x, &y);
+  XtVaSetValues(shell, XmNx, (Position)x, XmNy, (Position)y, NULL);
+ }
+
+ if (state.override)
+ {
+  XtRealizeWidget(shell);
+  calcul_shape(This);
+ }
+}
+
+/* ----------------------------------------------------------------- **
+** launcher_mapped - start tracking moves once the bar is up         **
+** ----------------------------------------------------------------- */
+static void launcher_mapped(This)
+c_Interface *This;
+{
+ state_restored = TRUE;
+ if (state.loaded && !state.have_pos)
+  schedule_save(This);		/* the reset position */
+}
