+/* ----------------------------------------------------------------- **
+** get_cardinals - read a CARDINAL[] property (up to max values)     **
+** ----------------------------------------------------------------- */
+static int get_cardinals(dpy, win, name, values, max)
+Display *dpy;
+Window win;
+char *name;
+long *values;
+int max;
+{
+ Atom type;
+ int format, i, n = 0;
+ unsigned long nitems, after;
+ unsigned char *data = NULL;
+
+ if (XGetWindowProperty(dpy, win, XInternAtom(dpy, name, False), 0, max,
+			False, XA_CARDINAL, &type, &format, &nitems, &after,
+			&data) == Success && data && type == XA_CARDINAL &&
+     format == 32)
+ {
+  n = (int)nitems;
+  for (i = 0; i < n && i < max; i++)
+   values[i] = ((long *)data)[i];	/* Xlib returns format 32 as long */
+ }
+ if (data)
+  XFree(data);
+ return n;
+}
+
+/* ----------------------------------------------------------------- **
+** dock_geometry - geometry string that puts the help window right   **
+** beside the program's main window, with the same height.           **
+** It goes to the left when there is no room on the right, and over  **
+** the monitor's right edge when there is room on neither side.      **
+** ----------------------------------------------------------------- */
+static boolean dock_geometry(dpy, shell, buf)
+Display *dpy;
+Widget shell;
+char *buf;
+{
+ Window win, root, child;
+ XWindowAttributes wa;
+ long ext[4] = { 0, 0, 0, 0 };	/* left, right, top, bottom */
+ long desk = 0, area[4];
+ int cx, cy, fx, fy, fw, fh, ex, ey;
+ int mx, my, mw, mh, x, y, w, h, room;
+
+ if (shell == NULL || (win = XtWindow(shell)) == (Window)0 ||
+     !XGetWindowAttributes(dpy, win, &wa) || wa.map_state != IsViewable)
+  return FALSE;
+ root = wa.root;
+ XTranslateCoordinates(dpy, win, root, 0, 0, &cx, &cy, &child);
+ get_cardinals(dpy, win, "_NET_FRAME_EXTENTS", ext, 4);
+ ex = (int)(ext[0] + ext[1]);
+ ey = (int)(ext[2] + ext[3]);
+ fx = cx - (int)ext[0];
+ fy = cy - (int)ext[2];
+ fw = wa.width + ex;
+ fh = wa.height + ey;
+
+ /* the monitor holding most of the main window */
+ mx = my = 0;
+ mw = WidthOfScreen(wa.screen);
+ mh = HeightOfScreen(wa.screen);
+ {
+  XineramaScreenInfo *mon;
+  int i, n, best = -1;
+  long ov, best_ov = -1;
+
+  if (XineramaIsActive(dpy) && (mon = XineramaQueryScreens(dpy, &n)) != NULL)
+  {
+   for (i = 0; i < n; i++)
+   {
+    int ox = MIN(fx + fw, mon[i].x_org + mon[i].width) - MAX(fx, mon[i].x_org);
+    int oy = MIN(fy + fh, mon[i].y_org + mon[i].height) - MAX(fy, mon[i].y_org);
+
+    ov = (ox > 0 && oy > 0) ? (long)ox * oy : 0;
+    if (ov > best_ov)
+    {
+     best_ov = ov;
+     best = i;
+    }
+   }
+   if (best >= 0)
+   {
+    mx = mon[best].x_org;
+    my = mon[best].y_org;
+    mw = mon[best].width;
+    mh = mon[best].height;
+   }
+   XFree(mon);
+  }
+ }
+
+ /* keep clear of panels: intersect with the current desktop work area */
+ get_cardinals(dpy, root, "_NET_CURRENT_DESKTOP", &desk, 1);
+ if (desk >= 0 && desk < 64)
+ {
+  long all[256];
+  int n = get_cardinals(dpy, root, "_NET_WORKAREA", all, 256);
+
+  if (n >= 4 * (desk + 1))
+  {
+   area[0] = MAX(mx, all[4 * desk]);
+   area[1] = MAX(my, all[4 * desk + 1]);
+   area[2] = MIN(mx + mw, all[4 * desk] + all[4 * desk + 2]);
+   area[3] = MIN(my + mh, all[4 * desk + 1] + all[4 * desk + 3]);
+   if (area[2] - area[0] >= DOCK_MIN_WIDTH + ex &&
+       area[3] - area[1] >= DOCK_MIN_HEIGHT + ey)
+   {
+    mx = (int)area[0];
+    my = (int)area[1];
+    mw = (int)(area[2] - area[0]);
+    mh = (int)(area[3] - area[1]);
+   }
+  }
+ }
+
+ w = DOCK_WIDTH;
+ if ((room = mx + mw - (fx + fw)) >= DOCK_WIDTH + ex)
+  x = fx + fw;			/* right side */
+ else if (fx - mx >= DOCK_WIDTH + ex)
+  x = fx - DOCK_WIDTH - ex;	/* left side */
+ else if (room >= DOCK_MIN_WIDTH + ex && room >= fx - mx)
+ {
+  x = fx + fw;			/* narrower, on the right */
+  w = room - ex;
+ }
+ else if (fx - mx >= DOCK_MIN_WIDTH + ex)
+ {
+  x = mx;			/* narrower, on the left */
+  w = fx - mx - ex;
+ }
+ else
+ {
+  w = MIN(DOCK_WIDTH, mw - ex);	/* overlap, at the monitor's right edge */
+  x = mx + mw - w - ex;
+ }
+
+ y = fy;
+ h = wa.height;
+ if (y < my)
+  y = my;
+ if (y + h + ey > my + mh)
+  h = my + mh - y - ey;
+ if (h < DOCK_MIN_HEIGHT)
+ {
+  y = my;
+  h = MAX(DOCK_MIN_HEIGHT, mh - ey);
+ }
+
+ sprintf(buf, "%dx%d+%d+%d", w, h, x, y);
+ Xc_TRACE(("help window geometry %s", buf));
+ return TRUE;
+}
