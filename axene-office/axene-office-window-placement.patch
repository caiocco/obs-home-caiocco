+** ----------------------------------------------------------------- */
+void XcSetShellGeometry(shell, geometry)
+Widget shell;
+char *geometry;
+{
+ Display *display = XtDisplay(shell);
+ int x, y, flags;
+ unsigned int width, height;
+ XSizeHints hints;
+ long supplied;
+
+ flags = XParseGeometry(geometry, &x, &y, &width, &height);
+ if (!(flags & XValue) || !(flags & YValue) ||
+     (flags & (XNegative | YNegative)))
+  return;
+ if (!(flags & WidthValue) || !(flags & HeightValue))
+ {
+  Dimension w, h;
+
+  XtVaGetValues(shell, XmNwidth, &w, XmNheight, &h, NULL);
+  if (!(flags & WidthValue)) width = w;
+  if (!(flags & HeightValue)) height = h;
+ }
+
+ /* a user-specified position, so the window manager doesn't re-place
+    the window if it maps it again */
+ if (XtWindow(shell) &&
+     XGetWMNormalHints(display, XtWindow(shell), &hints, &supplied))
+ {
+  hints.flags |= USPosition | USSize;
+  hints.x = x;
+  hints.y = y;
+  hints.width = width;
+  hints.height = height;
+  XSetWMNormalHints(display, XtWindow(shell), &hints);
+ }
+ XtVaSetValues(shell, XmNx, (Position)x, XmNy, (Position)y,
+	       XmNwidth, (Dimension)width, XmNheight, (Dimension)height,
+	       NULL);
