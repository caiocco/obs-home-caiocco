 /************************************************************************/
 /*									*/
+/*  The widget font is an Xft font (Motif 2.3 renderTable with		*/
+/*  fontType FONT_IS_XFT, e.g. set globally by CDE/NsCDE resources).	*/
+/*  Ted draws rulers and labels with core X fonts, so load a core font	*/
+/*  of about the same pixel size.					*/
+/*									*/
+/************************************************************************/
+
+static XFontStruct * drawCoreFontForXft(	Widget		w,
+						XtPointer	fontPtr,
+						int		sizeHint )
+    {
+    Display *		display= XtDisplay( w );
+    int			pixelSize= sizeHint;
+    char		name[200];
+    XFontStruct *	xfs;
+
+    static const char * const	patterns[]=
+	{
+	"-*-helvetica-medium-r-normal--%d-*-*-*-p-*-iso8859-1",
+	"-*-*-medium-r-normal--%d-*-*-*-p-*-iso8859-1",
+	"-*-*-medium-r-normal--%d-*-*-*-*-*-iso8859-1",
+	};
+    int			i;
+
+#   ifdef	USE_XFT
+    if  ( fontPtr )
+	{
+	XftFont *	xft= (XftFont *)fontPtr;
+	double		px= 0;
+
+	if  ( xft->pattern						&&
+	      XftPatternGetDouble( xft->pattern, XFT_PIXEL_SIZE, 0, &px )
+							== XftResultMatch &&
+	      px > 0							)
+	    { pixelSize= (int)( px+ 0.5 );		}
+	else{ pixelSize= xft->ascent+ xft->descent;	}
+	}
+#   endif
+
+    if  ( pixelSize < 6 || pixelSize > 72 )
+	{ pixelSize= 12;	}
+
+    for ( i= 0; i < sizeof(patterns)/sizeof(patterns[0]); i++ )
+	{
+	sprintf( name, patterns[i], pixelSize );
+	xfs= XLoadQueryFont( display, name );
+	if  ( xfs )
+	    { return xfs;	}
+	}
+
+    return XLoadQueryFont( display, "fixed" );
+    }
+
