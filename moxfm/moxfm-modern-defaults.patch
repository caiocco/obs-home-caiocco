+<RIFF WAVE>:sound.xpm:exec play $1:
 
 # common file types
 
-<FRAME>:framemaker.xpm:fmclient -f $1:
-<MAIL>:mail.xpm:exec xmailtool -file $1:
+<MAIL>:mail.xpm:EDIT:
 <BDF>:font.xpm:EDIT:
-<MAN>:manpage.xpm:groff -TX100 -man -mX -P-geometry -P655x860 $1:
