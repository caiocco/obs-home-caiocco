From 277d27fc9c1d3035071ba5e98446029143171fe1 Mon Sep 17 00:00:00 2001
From: caiocco <caiocco@yahoo.com.br>
Date: Thu, 12 Nov 2026 17:43:22 -0300
Subject: [PATCH] Modernize the default configuration

Replace programs that no longer exist (netscape, xv, xless, ghostview,
pixmap, xmailtool, fmclient, Mosaic, xanim, mpeg_play, xli, usermount)
with current ones: NEdit, Firefox, XImaging, gv, mupdf, mtpaint, mpv,
xterm+less. Use the freedesktop trash through gio. Drop the floppy and
CD-ROM entries, whose usermount helper and fixed mount points are gone.
Teach the magic file Exif JPEG, PNG, PDF and lower-case/doctype HTML.

---
 lib/Desktop       |  4 +---
 lib/Main          | 12 ++++------
 lib/Moxfm.cpp     |  4 ++--
 lib/magic         |  8 +++++--
 lib/moxfmdev      | 10 ++++++--
 lib/xfmmon        |  8 +++----
 lib/xfmrc         | 31 +++++++++++++------------
 lib/xfmrc.nomagic | 58 ++++++++++++++++++++++++-----------------------
 8 files changed, 72 insertions(+), 63 deletions(-)

diff --git a/lib/Desktop b/lib/Desktop
index 61e2c3f..a01161c 100644
--- a/lib/Desktop
+++ b/lib/Desktop
@@ -4,6 +4,4 @@
 #
 ##########################################
 
-Floppy:/:floppy:floppy.xpm:OPEN:COPY:10:120
-CD-ROM:/:cdrom:cdrom.xpm:OPEN::2:180
-Trash:~/.trash::trash_empty.xpm:OPEN:mv -f --backup=numbered $* ~/.trash:8:240
+Trash:~/.local/share/Trash/files::trash_empty.xpm:OPEN:gio trash $*:8:120
diff --git a/lib/Main b/lib/Main
index 1497104..17fbb2f 100644
--- a/lib/Main
+++ b/lib/Main
@@ -4,12 +4,10 @@
 #
 ##########################################
 
-Floppy:/:floppy:floppy.xpm:OPEN:COPY
-CD-ROM:/:cdrom:cdrom.xpm:OPEN:
-Trash:/root/.trash::trash_empty.xpm:OPEN:mv -f --backup=numbered $* ~/.trash
-Printer:::printer.xpm:exec /usr/bin/lpq | /usr/bin/X11/xless:exec lpr -#%Number of copies\:--1% $*
+Trash:~/.local/share/Trash/files::trash_empty.xpm:OPEN:gio trash $*
+Printer:::printer.xpm:exec xterm -T 'Print queue' -e sh -c 'lpq | less':exec lpr -#%Number of copies\:--1% $*
 Xterm:::xterm.xpm:exec xterm -sb -sl 500 -j:exec xterm -sb -j -e $1 %Arguments\:%
-Emacs:::emacs.xpm:exec emacs:exec emacs $*
-Netscape:::netscape.xpm:exec netscape:exec netscape $*
+NEdit:::edit.xpm:exec nedit:exec nedit $*
+Firefox:::netscape.xpm:exec firefox:exec firefox $*
 Gimp:::paint.xpm:exec gimp:exec gimp $*
-XV:/usr/X11/bin::xv.xpm:exec xv:exec xv $*
+XImaging:::pictures.xpm:exec ximaging -browse:exec ximaging $1
diff --git a/lib/Moxfm.cpp b/lib/Moxfm.cpp
index c1c475a..1ad37e9 100644
--- a/lib/Moxfm.cpp
+++ b/lib/Moxfm.cpp
@@ -221,10 +221,10 @@
 !*passedNamePolicy:		RelativePath
 
 ! The default editor to use
-*defaultEditor: 		exec emacs
+*defaultEditor: 		exec nedit
 
 ! The default viewer to use
-*defaultViewer:			exec xless
+*defaultViewer:			exec xterm -e less
 
 ! The xterm to call
 *xterm:				exec xterm -sb -sl 500 -j
diff --git a/lib/magic b/lib/magic
index 964c435..665f44c 100644
--- a/lib/magic
+++ b/lib/magic
@@ -24,14 +24,18 @@
 0	short		0x4949			TIFF
 0	string		GIF87a			GIF
 0	string		GIF89a			GIF
-0	long		0xFFD8FFE0		JPG
-0	long		0xFFD8FFEE		JPG
+0	string		\377\330\377		JPG
+0	string		\211PNG\r\n		PNG
+0	string		%PDF-			PDF
 0	long		0x01666370		PCF
 0	string		STARTFONT\ 2.1		BDF
 0	string		From			MAIL
 0	string		#FIG			FIG
 0	string		#XFM			XFM
 0	string		<HTML>			HTML
+0	regexp&512	\
+^[\ \t\r\n]*<![Dd][Oo][Cc][Tt][Yy][Pp][Ee][\ \t]+[Hh][Tt][Mm][Ll]	HTML
+0	regexp&512	^[\ \t\r\n]*<[Hh][Tt][Mm][Ll][\ \t>]	HTML
 0	string		/*\ XPM\ */		XPM
 0	regexp		\
 ^#define[\ \t]+[^\ \t]+_width[\ \t]+[0-9]+	XBM
diff --git a/lib/moxfmdev b/lib/moxfmdev
index 264802f..7f7f0f9 100644
--- a/lib/moxfmdev
+++ b/lib/moxfmdev
@@ -4,5 +4,11 @@
 #
 ##########################################################################
 
-Floppy:/dev/fd0:/floppy:usermount /dev/fd0:userumount /dev/fd0:SLOW
-CDROM:/dev/cdrom:/cdrom:usermount /dev/cdrom:userumount /dev/cdrom:SLOW
+# Format: name:device:mount point:mount command:unmount command:SLOW
+# The mount point must be a fixed directory. Removable media mounted by
+# udisks land under /run/media/$USER/<label>, so either give the device a
+# "user,noauto" entry in /etc/fstab, e.g.
+#   /dev/sr0  /media/cdrom  auto  user,noauto,ro  0 0
+# and use it here:
+#CD-ROM:/dev/sr0:/media/cdrom:mount /media/cdrom:umount /media/cdrom:SLOW
+# or point the mount point at a symlink kept up to date by a script.
diff --git a/lib/xfmmon b/lib/xfmmon
index 4d32229..b431b9d 100644
--- a/lib/xfmmon
+++ b/lib/xfmmon
@@ -13,11 +13,11 @@
 # Here's my favourite one: the sensitive trashcan icon. It assumes that
 # you use the trash_empty and trash_full icons and that the Trash application
 # is on the desktop.
-~/.trash:EMPTY::sed -e "s/trash_full.xpm/trash_empty.xpm/" ~/.moxfm/Desktop > ~/.moxfm/Desktop.new; mv ~/.moxfm/Desktop.new ~/.moxfm/Desktop
-~/.trash:NONEMPTY::sed -e "s/trash_empty.xpm/trash_full.xpm/" ~/.moxfm/Desktop > ~/.moxfm/Desktop.new; mv ~/.moxfm/Desktop.new ~/.moxfm/Desktop
+~/.local/share/Trash/files:EMPTY::sed -e "s/trash_full.xpm/trash_empty.xpm/" ~/.moxfm/Desktop > ~/.moxfm/Desktop.new; mv ~/.moxfm/Desktop.new ~/.moxfm/Desktop
+~/.local/share/Trash/files:NONEMPTY::sed -e "s/trash_empty.xpm/trash_full.xpm/" ~/.moxfm/Desktop > ~/.moxfm/Desktop.new; mv ~/.moxfm/Desktop.new ~/.moxfm/Desktop
 
-~/.trash:EMPTY::sed -e "s/trash_full.xpm/trash_empty.xpm/" ~/.moxfm/Main > ~/.moxfm/Main.new; mv ~/.moxfm/Main.new ~/.moxfm/Main
-~/.trash:NONEMPTY::sed -e "s/trash_empty.xpm/trash_full.xpm/" ~/.moxfm/Main > ~/.moxfm/Main.new; mv ~/.moxfm/Main.new ~/.moxfm/Main
+~/.local/share/Trash/files:EMPTY::sed -e "s/trash_full.xpm/trash_empty.xpm/" ~/.moxfm/Main > ~/.moxfm/Main.new; mv ~/.moxfm/Main.new ~/.moxfm/Main
+~/.local/share/Trash/files:NONEMPTY::sed -e "s/trash_empty.xpm/trash_full.xpm/" ~/.moxfm/Main > ~/.moxfm/Main.new; mv ~/.moxfm/Main.new ~/.moxfm/Main
 
 # Here's another one which checks for incoming mail (see the checkmail
 # shell script). (Make sure you edit this entry to include your user name.)
diff --git a/lib/xfmrc b/lib/xfmrc
index c3adc30..e927738 100644
--- a/lib/xfmrc
+++ b/lib/xfmrc
@@ -62,33 +62,34 @@
 
 # core dumps
 <data>core:core.xpm:exec ddd $1:
+<PDF>:pdf.xpm:exec mupdf $1:
 
 # image formats
 
-<PS>:ps.xpm:exec ghostview $1:
-<GIF>:gif.xpm:exec xv $1:
-<JPG>:jpeg.xpm:exec xv $1:
-<TIFF>:tiff.xpm:exec xv $1:
