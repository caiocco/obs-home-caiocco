 <FIG>:fig.xpm:exec xfig $1:
-<RAS>:raster.xpm:exec xv $1:
-<PBM>:pbm.xpm:exec xv $1:
-<PGM>:pgm.xpm:exec xv $1:
-<PPM>:ppm.xpm:exec xv $1:
