+; Remove the double quotes save-applications puts around a value
+(define (applications-unquote s)
+  (let ((n (string-length s)))
+    (if (and (>= n 2)
+	     (equal? (substring s 0 1) "\"")
+	     (equal? (substring s (- n 1) n) "\""))
+      (substring s 1 (- n 1))
+      s)))
+
+; Read the name=value lines written by save-applications or siagrun.
+; This used to be a stub, so settings were lost on every restart.
 (define (load-applications)
-  (let ((fp (fopen appfile "r")))
-; read line by line...
+  (let ((fp (fopen appfile "r"))
+	(line nil)
+	(eq nil)
+	(key nil)
+	(val nil))
+    (set! line (readline fp))
+    (while line
+      (set! eq (string-search "=" line))
+      (if eq
+	(begin
+	  (set! key (string-trim (substring line 0 eq)))
+	  (set! val (applications-unquote
+		      (string-trim (substring line (+ eq 1)
+					      (string-length line)))))
+	  (cond
+	    ((equal? key "viewer") (set! viewer-command val))
+	    ((equal? key "lpr") (set! lpr-command val))
+	    ((equal? key "editor") (set! editor-command val))
+	    ((equal? key "help") (set! help-command val))
+	    ((equal? key "filer") (set! filer-command val))
+	    ((equal? key "terminal") (set! terminal-command val))
+	    ((equal? key "calculator") (set! calculator-command val))
+	    (t nil))))
+      (set! line (readline fp)))
     (fclose fp)))
 
