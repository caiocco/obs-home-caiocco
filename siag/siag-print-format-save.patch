+; File - Print Format, shared by Siag, Pw and Egon. The form shows the
+; current commands, and what is entered is kept in applications.sh.
+(define (print-format)
+  (let ((props nil))
+    (form-begin)
+    (input-field "Previewer" 120 "viewer" 300 viewer-command)
+    (input-field "Print Command" 120 "lpr" 300 lpr-command)
+    (form-okbutton "OK")
+    (form-property XtNwidth 80)
+    (form-cancelbutton "Cancel")
+    (form-property XtNwidth 80)
+    (set! props (form-end))
+    (if props		; nil when cancelled; an empty field keeps the old command
+      (let ((viewer (extract-string "viewer" props))
+	    (lpr (extract-string "lpr" props)))
+	(set-applications (if (equal? viewer "") nil viewer)
+			  (if (equal? lpr "") nil lpr)
+			  nil nil nil nil nil)))))
+
 (define (exec-siod)
   (execute-interpreter-command 'SIOD))
 
