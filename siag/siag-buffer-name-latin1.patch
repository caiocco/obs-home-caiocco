+/*
+ * The X interfaces show text in ISO 8859-1 (dictionaries, Mowitz
+ * widgets, core fonts), but file names come from the file system in
+ * the locale's encoding, which is UTF-8 nowadays. Buffer names are
+ * derived from file names and shown in lists, tabs and prompts, so
+ * they are converted to Latin-1 when the buffer is named. Names that
+ * do not fit in Latin-1 are kept unchanged.
+ */
+static int utf8_locale(void)
+{
+	const char *cs = nl_langinfo(CODESET);
+	return cs && (!strcmp(cs, "UTF-8") || !strcmp(cs, "utf8"));
+}
+
+static int valid_utf8(const char *src)
+{
+	const unsigned char *p = (const unsigned char *)src;
+	while (*p) {
+		int k;
+		if (*p < 0x80) k = 0;
+		else if ((*p & 0xe0) == 0xc0 && *p >= 0xc2) k = 1;
+		else if ((*p & 0xf0) == 0xe0) k = 2;
+		else if ((*p & 0xf8) == 0xf0 && *p <= 0xf4) k = 3;
+		else return 0;
+		p++;
+		while (k--) {
+			if ((*p & 0xc0) != 0x80) return 0;
+			p++;
+		}
+	}
+	return 1;
+}
+
+/* file system name -> Latin-1 display name */
+char *fs_to_latin1(char *dst, const char *src, size_t n)
+{
+	const unsigned char *p = (const unsigned char *)src;
+	size_t i = 0;
+
+	if (utf8_locale()) {
+		while (*p && i + 1 < n) {
+			unsigned c = *p;
+			if (c < 0x80) p++;
+			else if ((c == 0xc2 || c == 0xc3)
+					&& (p[1] & 0xc0) == 0x80) {
+				c = ((c & 0x1f) << 6) | (p[1] & 0x3f);
+				p += 2;
+			} else break;
+			dst[i++] = (char)c;
+		}
+		if (*p == '\0') {
+			dst[i] = '\0';
+			return dst;
+		}
+	}
+	strncpy(dst, src, n - 1);
+	dst[n - 1] = '\0';
+	return dst;
+}
+
+/* Latin-1 display text -> locale encoding (e.g. for window titles,
+   which Xt converts from the locale) */
+char *latin1_to_locale(char *dst, const char *src, size_t n)
+{
+	const unsigned char *p = (const unsigned char *)src;
+	size_t i = 0;
+
+	if (!utf8_locale() || valid_utf8(src)) {
+		strncpy(dst, src, n - 1);
+		dst[n - 1] = '\0';
+		return dst;
+	}
+	for (; *p && i + 2 < n; p++) {
+		if (*p < 0x80) dst[i++] = *p;
+		else {
+			dst[i++] = 0xc0 | (*p >> 6);
+			dst[i++] = 0x80 | (*p & 0x3f);
+		}
+	}
+	dst[i] = '\0';
+	return dst;
+}
