+/* the window manager's close button cancels the form */
+static void form_wm_message(Widget w, XtPointer client_data,
+		XEvent *event, Boolean *cont)
+{
+	Atom wm_delete = (Atom)client_data;
+
+	if (event->type == ClientMessage &&
+	    (Atom)event->xclient.data.l[0] == wm_delete)
+		status = ABORT;
+}
